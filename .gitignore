# ---- secrets
.env
**/.env

# ---- per-folder virtual environments and installed packages
.venv/
**/.venv/
node_modules/
**/node_modules/
__pycache__/
*.pyc

# ---- AIDev: big or private files. Keep the folders (README.md/.gitkeep) but not the contents
AIDev/data/*
!AIDev/data/README.md
!AIDev/data/.gitkeep
AIDev/models/**/*.joblib
AIDev/experiments/*.joblib
# (AIDev/models/backup_20261019/model_content.joblib was committed before this rule existed, so git keeps tracking it)

# ---- build output and local files
DesktopApp/dist/
DesktopApp/release/
migrate_manifest.json
progress.txt

# ---- not sure want to ignore or not, it seem like last time claude auto generate file by prompt for knowing version
AIDev/requirements.lock.txt
Backend/requirements.lock.txt
DesktopApp/.vite/deps/_metadata.json
DesktopApp/.vite/deps/package.json
Extension/ui/package-lock.json
