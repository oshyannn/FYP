# Copy this file to .env (same folder as app.py) and fill it in. NEVER commit .env.

APP_ENV=development

# Long random string. Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Supabase dashboard > Connect > Direct tab > choose "Session pooler" > URI.
# Replace [YOUR-PASSWORD] (brackets included) and add ?sslmode=require at the end.
DATABASE_URL=

# Address that the links inside emails point to. Local testing: keep as is. For other devices use a public https address.
BASE_URL=http://127.0.0.1:5000

# Gmail sending (Google account > Security > 2-Step Verification > App passwords).
# Leave empty in development: the 6-digit codes are then printed in the terminal instead.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=SafeBrowse

# Optional: only accept these email domains at sign-up, e.g. gmail.com  (empty = any valid email)
ALLOWED_EMAIL_DOMAINS=

# true = /analyze needs a logged-in desktop user or a paired extension (turn on once the extension can pair)
REQUIRE_AUTH_FOR_ANALYZE=false

# Only needed if the desktop renderer calls the API directly from a dev server, e.g. http://localhost:5173
CORS_ORIGINS=

PHISHTANK_API_KEY=
