{
  "manifest_version": 3,
  "name": "Website Detector",
  "version": "1.0",

  "permissions": [
    "tabs",
    "notifications"
  ],

  "host_permissions": [
    "http://127.0.0.1/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  }
}