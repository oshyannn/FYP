{
  "manifest_version": 3,
  "name": "Website Detector",
  "version": "1.0",

  "permissions": [
    "tabs",
    "webNavigation",
    "notifications",
    "storage",
    "downloads"
  ],

  "host_permissions": [
    "http://127.0.0.1/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  },

"content_scripts": [
  {
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_start",
    "all_frames": true
  }
]
}

