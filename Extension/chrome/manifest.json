{
  "manifest_version": 3,
  "name": "SafeBrowse",
  "version": "1.1.0",
  "description": "Checks every website before it opens and blocks phishing and malicious pages. Pair it with the SafeBrowse desktop app.",

  "permissions": [
    "tabs",
    "webNavigation",
    "notifications",
    "storage",
    "downloads"
  ],

  "host_permissions": [
    "http://127.0.0.1/*"
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "SafeBrowse",
    "default_popup": "popup/index.html"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
