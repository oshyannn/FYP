# Copy this file to .env inside AIDev/ and fill it in. NEVER commit .env.
# The detector and the data pipeline read these. Backend also picks them up because it imports the detector.

# PhishTank: free key from https://phishtank.org/api_info.php (needed for import_phishtank and live lookups)
PHISHTANK_API_KEY=

# Google Safe Browsing Lookup API v4. Optional; leave empty to switch the provider off.
# Note: the Lookup API sends the full URL to Google.
GOOGLE_SAFE_BROWSING_API_KEY=

# Optional switches. 0 = off, 1 = on (defaults: adult list on, content check on)
BLOCK_ADULT=1
CONTENT_CHECK=1
